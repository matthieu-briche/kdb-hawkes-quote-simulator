/ =====================================================================
/ QCumber tests for lib/hawkes.q (simulator, residual tests, quotes)
/ Usage (from the repository root):
/   q qcumber.q_ -src tests/load.q -test tests/hawkes.quke
/ Same checks as the lib/hawkes.q sections of tests/run.q, in QCumber form.
/ =====================================================================

feature Hawkes simulator

    before
        system "S 42";

    should reject a non-stationary process
        expect an error when alpha >= beta
            r:@[hawkesBranch[1f;60f;50f];1000f;{x}];
            (10h=type r) & r like "non-stationary*"

    should return valid event times
        expect sorted times in [0,T)
            t:hawkesBranch[1f;30f;50f;1000f];
            (t~asc t) & (all t>=0) & all t<1000f

    should produce the expected mean count
        expect a Poisson count mu*T when alpha = 0 (+/- 5 sd)
            N:count hawkesBranch[2f;0f;50f;10000f];
            5>abs (N-20000)%sqrt 20000
        expect a mean count mu*T/(1-n) (+/- 5 sd)
            N:count hawkesBranch[1f;25f;50f;20000f];
            5>abs (N-40000)%sqrt 20000%0.5 xexp 3

    should give Exp(1) compensator residuals
        expect mean, variance, KS and lag-1 acf consistent with Exp(1)
            t:hawkesBranch[1f;40f;50f;5000f];
            x:comp[t;1f;40f;50f]; N:count x; se:1%sqrt N;
            (5>abs (avg[x]-1)%se) & (5>abs (var[x]-1)%sqrt 8%N) & (ksStat[x]<2*1.358*se) & 5>abs[acf[x;1]]%se

feature Residual tests

    before
        system "S 42";
        `ts set asc 300?20f;

    should compute the compensator correctly
        expect alpha = 0 to reduce to mu * inter-event times
            1e-12>max abs comp[ts;2f;0f;50f]-2*deltas ts
        expect a tie to give an increment of exactly 0
            0f=last comp[ts,last ts;1f;30f;50f]

    should compute the KS statistic correctly
        expect 0.5 for one point at the Exp(1) median
            1e-12>abs 0.5-ksStat enlist log 2
        expect KS >= p for a mass p at 0 (the 1 ms tie artefact)
            0.0999<ksStat (1000#0f),neg log 1-9000?1f

    should compute the autocorrelation correctly
        expect lag 1 of an alternating series to be -(n-1)/n
            1e-12>abs 0.99+acf[100#1 -1f;1]
        expect lag 0 to be 1
            1e-12>abs 1-acf[ts;0]

    after
        delete ts from `.;

feature Quote table

    before
        system "S 42";
        `qt set mkQuote `GOOG;

    should match the tickerplant schema in sym.q
        expect the same columns
            `time`sym`bid`ask`bsize`asize~cols qt
        expect the same types
            "nsffjj"~exec t from meta qt

    should produce consistent quotes
        expect sorted 1 ms timestamps inside the session
            tm:qt`time;
            (tm~asc tm) & (all 0=("j"$tm) mod 1000000) & (all tm>=sessOpen) & all tm<=sessOpen+"n"$1e9*T
        expect a spread of 1 to 3 cents
            all ("j"$100*qt[`ask]-qt`bid) within 1 3
        expect round lots of 100 to 1000
            (all qt[`bsize] in 100*1+til 10) & all qt[`asize] in 100*1+til 10

    after
        delete qt from `.;
