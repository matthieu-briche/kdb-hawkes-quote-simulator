/ =====================================================================
/ QCumber tests for lib/mle.q (likelihood, Nelder-Mead, Hessian, MLE)
/ Usage (from the repository root):
/   q qcumber.q_ -src tests/load.q -test tests/mle.quke
/ Same checks as the lib/mle.q sections of tests/run.q, in QCumber form.
/ =====================================================================

feature Likelihood

    before
        system "S 42";
        `ts set asc 300?20f;

    should reduce to the Poisson likelihood when alpha = 0
        expect log L = N log mu - mu T
            1e-9>abs logL[ts;20f;2f;0f;50f]-(count[ts]*log 2)-40f

    should map the unconstrained parameters back
        expect toNat to return (mu; alpha; beta)
            1e-9>max abs toNat[(log 0.8;log 0.7%0.3;log 50)]-0.8 35 50f

    after
        delete ts from `.;

feature Optimiser and Hessian

    should minimise the Rosenbrock function
        expect (1;1) from (-1.2;1)
            r:nelderMead[{a:x[1]-x[0]*x 0; b:1-x 0; (100*a*a)+b*b};-1.2 1f;1e-12;5000];
            1e-4>max abs r[`x]-1 1f

    should minimise a 3-d quadratic
        expect the minimum at (1;-2;3)
            r:nelderMead[{sum d*d:x-1 -2 3f};0 0 0f;1e-12;5000];
            1e-4>max abs r[`x]-1 -2 3f

    should respect maxit
        expect exactly maxit iterations when stopped early
            5=(nelderMead[{sum x*x};10 10f;1e-12;5])`iter

    should differentiate a quadratic form exactly
        expect the Hessian to equal the matrix
            A:(4 1 0f;1 3 0.5;0 0.5 2f);
            1e-5>max raze abs hess[{[A;x](0.5*x mmu A mmu x)+sum x}[A];1 2 3f]-A

feature End-to-end MLE

    before
        system "S 42";
        t:hawkesBranch[1f;40f;50f;5000f]; N:count t;
        r:nelderMead[nllX[t;5000f];(log 0.5*N%5000;0f;log 10f);1e-9;1000];
        p:toNat r`x;
        se:sqrt {x[y;y]}[inv hess[nllP[t;5000f];p]] each til 3;
        `fitRes set `p`se`z`iter!(p;se;(p-1 40 50f)%se;r`iter);

    should converge
        expect fewer than maxit iterations
            fitRes[`iter]<1000
        expect positive, finite standard errors
            all (fitRes[`se]>0) & fitRes[`se]<0w

    should recover the true parameters
        expect |z| < 4 for mu, alpha and beta
            all 4>abs fitRes`z

    after
        delete fitRes from `.;
